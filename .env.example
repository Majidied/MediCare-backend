# ==============================================================================
# MediCare Microservices Backend — Environment Variables Template
# Copy to `.env` (for Docker Compose) and per-service `./env/<service>.env`
# ==============================================================================

# --- PostgreSQL (matches docker/postgres/.env.example) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_me_postgres_admin

ANALYTICS_PASSWORD=change_me_analytics
APPOINTMENT_PASSWORD=change_me_appointment
BILLING_PASSWORD=change_me_billing
CHATBOT_PASSWORD=change_me_chatbot
CLINIC_PASSWORD=change_me_clinic
CONSULTATION_PASSWORD=change_me_consultation
MEDICAL_RECORD_PASSWORD=change_me_medical_record
MEDICATION_PASSWORD=change_me_medication
NOTIFICATION_PASSWORD=change_me_notification
PATIENT_PASSWORD=change_me_patient
PAYMENT_PASSWORD=change_me_payment
PRESCRIPTION_PASSWORD=change_me_prescription
QUEUE_PASSWORD=change_me_queue
USER_PASSWORD=change_me_user

# --- Spring Cloud Discovery & Config ---
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://discovery-service:8761/eureka/
SPRING_CLOUD_CONFIG_URI=http://localhost:8888
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# --- Apache Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=broker:29092

# --- Keycloak OIDC / OAuth2 ---
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/medicare
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/medicare/protocol/openid-connect/certs
KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8180
KEYCLOAK_ADMIN_REALM=medicare
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_keycloak_secret

# --- Stripe Payments (payment-service) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Spring AI / Google Gemini (chatbot-service) ---
SPRING_AI_GOOGLE_GENAI_API_KEY=replace_with_gemini_api_key
